{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "timeout 60 bash /opt/claude-cloud-kit/setup.sh --refresh >/dev/null 2>&1; python3 /opt/claude-cloud-kit/bin/cloud-prep --hook",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /opt/claude-cloud-kit/hooks/guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
