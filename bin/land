#!/usr/bin/env python3
"""land — land the current branch from a Claude Code cloud session, REST only.

  push → open PR → wait for CI → squash-merge → switch to the synced default branch.

The cloud GitHub proxy rejects GraphQL (so `gh pr` and zs-land cannot run) and branch
deletion. This script keeps zs-land's safety rules with `gh api` REST calls only:

- Refuses main, master, the default branch, a detached HEAD, a dirty tree and a branch
  with no commits. Pushes the exact commit it read (HEAD's SHA), never a moving ref.
- Repository = what GitHub resolves from origin (renames followed); every call is pinned to it.
- Merges only when the owner is in the allowlist (LAND_OWNERS, default
  "wiggdevin ZeroSum-Solutions") and neither the repo nor its pre-rename name is in
  policy/client-repos.txt (an unreadable policy file means no auto-merge).
  Otherwise it pushes, opens the PR and stops: the human review gate stays.
- Lands only an OPEN, non-draft PR whose base is the current default branch. Immediately
  before the merge it re-reads the PR, the default branch and CI; the merge call pins the
  head SHA.
- CI gate: every non-advisory check run and commit status must pass or be skipped, with at
  least one real pass. Pending waits; failure, cancelled, neutral, timed out or action
  required blocks. No passing check after LAND_NO_CI_GRACE seconds fails closed. A pass is
  trusted only LAND_PR_SETTLE seconds after the PR opened, so PR workflows can register.
  The cloud GitHub app cannot read commit statuses; then the PR's mergeable_state must be
  "clean" (GitHub's own roll-up of every status and check) before the merge.
  Advisory checks (LAND_ADVISORY_CHECKS or `git config zs-land.advisoryChecks`, comma
  separated) are left out of both sides: they cannot block and cannot count as verification.
- The squash commit gets an explicit message (the commit subjects), so text the cloud proxy
  appends to PR bodies never reaches the default branch; land also strips that footer.

Exit: 0 landed, or PR opened and stopped by policy or --pr
      1 nothing merged (precondition, CI, conflict or merge refused) — PR left open
      3 PR MERGED (or the merge result is unknown) but the follow-up is incomplete —
        finish by hand, do not re-run
      2 usage error

Usage: land [--pr] [--dry-run] [--title TITLE] [--body-file FILE]
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path
from urllib.parse import quote

KIT_DIR = Path(os.environ.get("CLOUD_KIT_DIR", Path(__file__).resolve().parent.parent))
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from kitpolicy import policy_for, split_list  # noqa: E402
POLL = float(os.environ.get("LAND_POLL", "15"))
CI_TIMEOUT = float(os.environ.get("LAND_CI_TIMEOUT", "2700"))
NO_CI_GRACE = float(os.environ.get("LAND_NO_CI_GRACE", "120"))
SETTLE = float(os.environ.get("LAND_SETTLE", "15"))
PR_SETTLE = float(os.environ.get("LAND_PR_SETTLE", "45"))
BLOCKED_WAIT = float(os.environ.get("LAND_BLOCKED_WAIT", "300"))
PROTECTED = {"main", "master"}

FAIL_CONCLUSIONS = {"failure", "timed_out", "action_required", "startup_failure", "stale"}
BLOCK_CONCLUSIONS = {"cancelled", "neutral"}


class Stop(Exception):
    """Ends the run with a message and an exit code."""

    def __init__(self, message: str, code: int = 1):
        super().__init__(message)
        self.code = code


class GhError(Exception):
    def __init__(self, path: str, message: str):
        super().__init__(f"{path}: {message}")
        self.message = message

    @property
    def forbidden(self) -> bool:
        return "not accessible by integration" in self.message.lower() or "(HTTP 403)" in self.message


# ---------------------------------------------------------------- shell helpers

def _env() -> dict:
    env = dict(os.environ)
    # An inherited GH_REPO / GH_HOST could point gh at a different repository than the
    # one the policy check read. zs-land drops them for the same reason.
    env.pop("GH_REPO", None)
    env.pop("GH_HOST", None)
    env["GH_PROMPT_DISABLED"] = "1"
    return env


def git(*args: str, check: bool = True) -> str:
    proc = subprocess.run(["git", *args], capture_output=True, text=True, env=_env())
    if check and proc.returncode != 0:
        raise Stop(f"✗ git {' '.join(args)} failed: {proc.stderr.strip() or proc.stdout.strip()}")
    return proc.stdout.strip()


def git_ok(*args: str) -> bool:
    return subprocess.run(["git", *args], capture_output=True, env=_env()).returncode == 0


def gh_api(path: str, method: str = "GET", body: dict | None = None):
    cmd = ["gh", "api", "--method", method, "-H", "Accept: application/vnd.github+json", path]
    if body is not None:
        cmd += ["--input", "-"]
    proc = subprocess.run(
        cmd,
        input=json.dumps(body) if body is not None else None,
        capture_output=True,
        text=True,
        env=_env(),
    )
    if proc.returncode != 0:
        detail = proc.stdout.strip()
        try:
            detail = json.loads(detail).get("message", detail)
        except (ValueError, AttributeError):
            pass
        raise GhError(path, detail or proc.stderr.strip())
    return json.loads(proc.stdout) if proc.stdout.strip() else {}


def gh_list(path: str, key: str | None = None) -> list:
    """All pages of a list endpoint (key = the array field for wrapped responses)."""
    items: list = []
    sep = "&" if "?" in path else "?"
    for page in range(1, 51):
        data = gh_api(f"{path}{sep}per_page=100&page={page}")
        chunk = data.get(key, []) if key else data
        items.extend(chunk)
        if len(chunk) < 100:
            return items
    raise Stop(f"✗ {path} has more than 5000 entries — refusing to judge a cut-off list")


def say(msg: str) -> None:
    print(msg, flush=True)


# ---------------------------------------------------------------- pure logic (tested)

_NWO_PATTERNS = (
    re.compile(r"^(?:https?|ssh|git)://(?:[^@/\s]+@)?github\.com(?::\d+)?/([^/\s]+)/([^/\s]+?)(?:\.git)?/?$"),
    re.compile(r"^[^@/\s]+@github\.com:([^/\s]+)/([^/\s]+?)(?:\.git)?/?$"),
    # the cloud session's local git proxy: http://<cred>@127.0.0.1:<port>/git/<owner>/<repo>
    re.compile(r"^https?://(?:[^@/\s]+@)?(?:127\.0\.0\.1|localhost)(?::\d+)?/git/([^/\s]+)/([^/\s]+?)(?:\.git)?/?$"),
)

_PROXY_FOOTER = re.compile(r"\n*-{3,}\n_Generated by \[Claude Code\]\(https://claude\.ai/code/[^)\s]*\)_\s*$")


def parse_nwo(url: str) -> str | None:
    for pattern in _NWO_PATTERNS:
        m = pattern.search(url.strip())
        if m:
            return f"{m.group(1)}/{m.group(2)}"
    return None


@dataclass
class Verdict:
    state: str  # pass | fail | pending | skipped (nothing verified yet) | none
    passed: list[str]
    pending: list[str]
    failed: list[str]
    skipped: list[str]
    advisory: list[str]


def judge(check_runs: list[dict], statuses: list[dict], advisory: set[str]) -> Verdict:
    passed, pending, failed, skipped, adv = [], [], [], [], []
    for run in check_runs:
        name = run.get("name") or "?"
        if name in advisory:
            adv.append(name)
            continue
        if run.get("status") != "completed":
            pending.append(name)
            continue
        conclusion = (run.get("conclusion") or "").lower()
        if conclusion == "success":
            passed.append(name)
        elif conclusion == "skipped":
            skipped.append(name)
        elif conclusion in FAIL_CONCLUSIONS or conclusion in BLOCK_CONCLUSIONS:
            failed.append(f"{name} [{conclusion}]")
        else:
            failed.append(f"{name} [{conclusion or 'unknown'}]")
    for status in statuses:
        name = status.get("context") or "?"
        if name in advisory:
            adv.append(name)
            continue
        state = (status.get("state") or "").lower()
        if state == "success":
            passed.append(name)
        elif state == "pending":
            pending.append(name)
        else:
            failed.append(f"{name} [{state or 'unknown'}]")
    if failed:
        state = "fail"
    elif pending:
        state = "pending"
    elif passed:
        state = "pass"
    elif skipped:
        state = "skipped"  # only skips so far: nothing verified; wait for real checks
    else:
        state = "none"
    return Verdict(state, passed, pending, failed, skipped, adv)


def latest_runs(check_runs: list[dict]) -> list[dict]:
    """The newest attempt of each check per check suite. `filter=latest` would also merge
    same-named jobs from different workflows, hiding a failure behind a later pass."""
    newest: dict[tuple, dict] = {}
    for run in check_runs:
        key = ((run.get("check_suite") or {}).get("id"), (run.get("app") or {}).get("id"), run.get("name"))
        if key not in newest or (run.get("id") or 0) > (newest[key].get("id") or 0):
            newest[key] = run
    return list(newest.values())


def strip_proxy_footer(body: str | None) -> str:
    return _PROXY_FOOTER.sub("\n", body or "").rstrip("\n") + "\n"


def squash_message(subjects: list[str]) -> str:
    return "\n".join(f"* {s}" for s in subjects) if len(subjects) > 1 else ""


def pr_body(subjects: list[str]) -> str:
    lines = ["## Summary", ""]
    lines += [f"- {s}" for s in subjects] or ["- (no commit subjects)"]
    lines += ["", "## Test plan", "", "- [x] CI checks on this PR (gated by `land`)"]
    return "\n".join(lines) + "\n"


# ---------------------------------------------------------------- steps

@dataclass
class Repo:
    nwo: str
    owner: str
    default: str
    delete_branch_on_merge: bool


def resolve_repo() -> Repo:
    if not git_ok("rev-parse", "--is-inside-work-tree"):
        raise Stop("✗ not a git repository")
    url = git("remote", "get-url", "origin", check=False)
    if not url:
        raise Stop("✗ no 'origin' remote")
    nwo = parse_nwo(url)
    if not nwo:
        raise Stop(f"✗ origin is not a GitHub repository: {url}")
    try:
        data = gh_api(f"repos/{nwo}")
    except GhError as e:
        raise Stop(f"✗ cannot read {nwo} through the GitHub proxy: {e.message}")
    return Repo(
        nwo=data["full_name"],
        owner=data["owner"]["login"],
        default=data["default_branch"],
        delete_branch_on_merge=bool(data.get("delete_branch_on_merge")),
    )


def preflight(repo: Repo) -> tuple[str, list[str]]:
    branch = git("rev-parse", "--abbrev-ref", "HEAD")
    if branch == "HEAD":
        raise Stop("✗ detached HEAD — check out a feature branch first")
    if branch == repo.default or branch in PROTECTED:
        raise Stop(f"✗ on {branch}, a protected branch — create a feature branch: git switch -c <type>/<topic>")
    if git("status", "--porcelain"):
        raise Stop("✗ working tree not clean — commit or stash first")
    git("fetch", "-q", "origin", f"+refs/heads/{repo.default}:refs/remotes/origin/{repo.default}")
    base = f"origin/{repo.default}"
    subjects = git("log", "--reverse", "--format=%s", f"{base}..HEAD").splitlines()
    if not subjects:
        raise Stop(f"✗ no commits ahead of {repo.default} — nothing to land")
    return branch, subjects


def find_or_open_pr(repo: Repo, branch: str, subjects: list[str], title: str | None,
                    body: str | None) -> tuple[dict, bool]:
    """Returns (pr, opened_now)."""
    head = quote(f"{repo.owner}:{branch}", safe=":/")
    prs = gh_list(f"repos/{repo.nwo}/pulls?state=open&head={head}")
    other = [p for p in prs if p["base"]["ref"] != repo.default]
    if other:
        raise Stop(f"✗ the open PR for {branch} targets {other[0]['base']['ref']}, not {repo.default} "
                   f"(stacked PRs are not landed from the cloud): {other[0]['html_url']}")
    if prs:
        pr = prs[0]
        say(f"… PR #{pr['number']} already open: {pr['html_url']}")
        changes = {k: v for k, v in (("title", title), ("body", body)) if v is not None}
        if changes:
            pr = gh_api(f"repos/{repo.nwo}/pulls/{pr['number']}", "PATCH", changes)
            say(f"✓ updated the PR {' and '.join(changes)}")
        return clean_body(repo, pr), False
    pr = gh_api(f"repos/{repo.nwo}/pulls", "POST", {
        "title": title or subjects[0],
        "head": branch,
        "base": repo.default,
        "body": body if body is not None else pr_body(subjects),
        "draft": False,
    })
    say(f"✓ opened PR #{pr['number']}: {pr['html_url']}")
    return clean_body(repo, pr), True


def clean_body(repo: Repo, pr: dict) -> dict:
    """The cloud proxy appends a "Generated by Claude Code" footer to PR bodies. Remove it."""
    body = pr.get("body") or ""
    if not _PROXY_FOOTER.search(body):
        return pr
    try:
        pr = gh_api(f"repos/{repo.nwo}/pulls/{pr['number']}", "PATCH", {"body": strip_proxy_footer(body)})
    except GhError as e:
        say(f"ℹ could not remove the proxy footer from the PR body ({e.message})")
        return pr
    if _PROXY_FOOTER.search(pr.get("body") or ""):
        say("ℹ the proxy re-added its footer to the PR body; the squash commit message excludes it")
    return pr


def read_checks(repo: Repo, sha: str, advisory: set[str]) -> tuple[Verdict, bool]:
    """(verdict, statuses_readable). The cloud GitHub app has no commit-status permission;
    then only check runs are judged here and mergeable_state covers statuses."""
    runs = latest_runs(gh_list(f"repos/{repo.nwo}/commits/{sha}/check-runs?filter=all", "check_runs"))
    try:
        statuses = gh_list(f"repos/{repo.nwo}/commits/{sha}/status", "statuses")
        readable = True
    except GhError as e:
        if not e.forbidden:
            raise
        statuses, readable = [], False
    return judge(runs, statuses, advisory), readable


def read_pr(repo: Repo, number: int) -> dict:
    """The PR once GitHub has computed mergeability (it is null for a few seconds)."""
    live = gh_api(f"repos/{repo.nwo}/pulls/{number}")
    for _ in range(6):
        if live.get("mergeable") is not None and live.get("mergeable_state") != "unknown":
            break
        time.sleep(3)
        live = gh_api(f"repos/{repo.nwo}/pulls/{number}")
    return live


ROLLUP_OK = {"clean", "has_hooks"}


def ci_state(repo: Repo, number: int, sha: str, url: str, advisory: set[str]) -> tuple[Verdict, str]:
    """One reading of CI: (verdict, rollup). rollup is "ok", "wait", "blocked" or a Stop."""
    try:
        verdict, readable = read_checks(repo, sha, advisory)
    except GhError as e:
        raise Stop(f"✗ could not read CI for {sha[:7]}: {e.message} — PR left open: {url}")
    if verdict.state != "pass" or readable:
        return verdict, "ok"
    # Statuses are invisible to this token: GitHub's roll-up has to agree.
    live = read_pr(repo, number)
    state = live.get("mergeable_state")
    if live.get("head", {}).get("sha") != sha:
        raise Stop(f"✗ branch head changed during the CI wait — merge aborted, PR left open: {url}")
    if state in ROLLUP_OK:
        return verdict, "ok"
    if state == "dirty":
        raise Stop(f"✗ PR #{number} conflicts with {repo.default} — rebase onto origin/{repo.default}, "
                   f"push with --force-with-lease, run land again: {url}")
    if state == "behind":
        raise Stop(f"✗ PR #{number} is behind {repo.default} and the repo requires it up to date — rebase, "
                   f"push with --force-with-lease, run land again: {url}")
    return verdict, "blocked" if state == "blocked" else "wait"


def wait_for_ci(repo: Repo, number: int, sha: str, url: str, advisory: set[str],
                opened_at: float | None) -> Verdict:
    start = time.monotonic()
    last = None
    settled = False
    blocked_since = None
    while True:
        verdict, rollup = ci_state(repo, number, sha, url, advisory)
        elapsed = time.monotonic() - start
        if verdict.state == "fail":
            raise Stop(f"✗ CI failed: {', '.join(verdict.failed)} — PR left open: {url}")
        if verdict.state == "pass" and rollup == "ok":
            young = opened_at is not None and time.monotonic() - opened_at < PR_SETTLE
            if settled and not young:
                return verdict
            # A workflow can register its checks after the first one finishes, and PR
            # workflows register a little after the PR opens. Read again after a pause.
            settled = True
            time.sleep(SETTLE)
            continue
        settled = False
        if rollup == "blocked":
            blocked_since = blocked_since or time.monotonic()
            if time.monotonic() - blocked_since >= BLOCKED_WAIT:
                raise Stop(f"✗ every check run passed but GitHub still reports the PR as blocked after "
                           f"{int(BLOCKED_WAIT)}s (a required review, or a failing status this token "
                           f"cannot read) — PR left open: {url}")
        else:
            blocked_since = None
        if verdict.state in ("none", "skipped") and elapsed >= NO_CI_GRACE:
            what = "only skipped checks" if verdict.state == "skipped" else "no CI checks"
            raise Stop(f"✗ {what} after {int(NO_CI_GRACE)}s — nothing was verified; "
                       f"PR left open for a human merge: {url}")
        if elapsed >= CI_TIMEOUT:
            raise Stop(f"✗ CI still running after {int(CI_TIMEOUT)}s ({', '.join(verdict.pending)}) — "
                       f"PR left open; run land again to resume: {url}")
        if verdict.pending:
            line = f"… waiting for CI: {len(verdict.pending)} pending ({', '.join(verdict.pending[:4])})"
        elif verdict.state == "pass":
            line = "… check runs green; waiting for GitHub's status roll-up"
        else:
            line = "… waiting for CI checks to appear"
        if line != last:
            say(line)
            last = line
        time.sleep(POLL)


def recheck(repo: Repo, number: int, sha: str, url: str, advisory: set[str]) -> dict:
    """Everything the merge depends on, read again right before it."""
    current_default = gh_api(f"repos/{repo.nwo}").get("default_branch")
    if current_default != repo.default:
        raise Stop(f"✗ the default branch changed to {current_default} during the CI wait — "
                   f"merge aborted, PR left open: {url}")
    verdict, rollup = ci_state(repo, number, sha, url, advisory)
    if verdict.state != "pass" or rollup != "ok":
        raise Stop(f"✗ CI changed right before the merge ({verdict.state}"
                   f"{', ' + ', '.join(verdict.failed or verdict.pending) if verdict.failed or verdict.pending else ''})"
                   f" — merge aborted, PR left open; run land again: {url}")
    live = read_pr(repo, number)
    if live["state"] != "open":
        raise Stop(f"✗ PR #{number} is {live['state']} — nothing merged: {url}")
    if live.get("draft"):
        raise Stop(f"✗ PR #{number} is a draft; mark it ready on GitHub (the cloud proxy cannot): {url}")
    if live["head"]["sha"] != sha or git("rev-parse", "HEAD") != sha:
        raise Stop(f"✗ branch head changed during the CI wait — merge aborted, PR left open: {url}")
    if live["base"]["ref"] != repo.default:
        raise Stop(f"✗ PR base changed to {live['base']['ref']} — merge aborted, PR left open: {url}")
    if live.get("mergeable") is None:
        raise Stop(f"✗ GitHub has not computed whether PR #{number} can merge — PR left open; "
                   f"run land again: {url}")
    if live.get("mergeable") is False:
        raise Stop(f"✗ PR #{number} conflicts with {repo.default} — rebase onto origin/{repo.default}, "
                   f"push with --force-with-lease, run land again: {url}")
    return live


def merge(repo: Repo, pr: dict, sha: str, subjects: list[str]) -> str:
    number, url = pr["number"], pr["html_url"]
    try:
        result = gh_api(f"repos/{repo.nwo}/pulls/{number}/merge", "PUT", {
            "merge_method": "squash",
            "sha": sha,
            "commit_title": f"{pr['title']} (#{number})",
            # Explicit, so the repo's PR_BODY setting cannot copy the proxy footer into history.
            "commit_message": squash_message(subjects),
        })
    except GhError as e:
        # A dropped response can hide a merge that happened. Ask before reporting "nothing merged".
        after = None
        for _ in range(4):
            try:
                after = gh_api(f"repos/{repo.nwo}/pulls/{number}")
                break
            except GhError:
                time.sleep(3)
        if after is None:
            raise Stop(f"✗ the merge call failed ({e.message}) and the PR cannot be read — it may have "
                       f"merged. Check {url} before doing anything; do NOT re-run land", 3)
        if after.get("merged") and after.get("head", {}).get("sha") == sha:
            return after.get("merge_commit_sha") or ""
        hint = ""
        if "merge queue" in e.message.lower():
            hint = " (this repo uses a merge queue; enqueue it on GitHub)"
        raise Stop(f"✗ GitHub refused the merge: {e.message}{hint} — PR left open: {url}")
    if not result.get("merged"):
        raise Stop(f"✗ GitHub did not merge PR #{number}: {result.get('message')} — PR left open: {url}")
    return result.get("sha", "")


def after_merge(repo: Repo, pr: dict, branch: str, sha: str, merge_sha: str) -> list[str]:
    """Prove the merge landed, then tidy up. Returns problems; any problem means exit 3."""
    problems: list[str] = []
    number = pr["number"]
    merged = gh_api(f"repos/{repo.nwo}/pulls/{number}")
    merge_sha = merged.get("merge_commit_sha") or merge_sha
    if not merged.get("merged") or not merge_sha:
        return [f"GitHub does not report PR #{number} as merged"]

    landed = False
    for _ in range(5):
        git("fetch", "-q", "origin", repo.default, check=False)
        if git_ok("merge-base", "--is-ancestor", merge_sha, f"origin/{repo.default}"):
            landed = True
            break
        time.sleep(3)
    if not landed:
        return [f"merge commit {merge_sha[:7]} is not on origin/{repo.default} yet"]

    if not repo.delete_branch_on_merge:
        try:
            gh_api(f"repos/{repo.nwo}/git/refs/heads/{quote(branch, safe='/')}", "DELETE")
            say(f"✓ deleted remote branch {branch}")
        except GhError as e:
            say(f"ℹ remote branch {branch} left in place ({e.message}); turn on "
                f"'Automatically delete head branches' in the repo settings")

    if git("rev-parse", "HEAD") == sha and not git("status", "--porcelain"):
        git("switch", "-q", repo.default)
        if not git_ok("merge", "-q", "--ff-only", f"origin/{repo.default}"):
            problems.append(f"local {repo.default} could not fast-forward to origin/{repo.default}")
        elif not git_ok("update-ref", "-d", f"refs/heads/{branch}", sha):
            problems.append(f"local branch {branch} moved after the merge; left as it is")
    else:
        problems.append(f"local branch {branch} moved after the merge; left as it is")
    return problems


# ---------------------------------------------------------------- main

def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(prog="land", description="Land the current branch (cloud, REST only).")
    ap.add_argument("--pr", action="store_true", help="push and open the PR, then stop")
    ap.add_argument("--dry-run", action="store_true", help="show what would happen; change nothing")
    ap.add_argument("--title", help="PR title (default: the oldest commit subject)")
    ap.add_argument("--body-file", help="PR body from this file (default: commit list + test plan)")
    args = ap.parse_args(argv)

    body = None
    if args.body_file:
        try:
            body = Path(args.body_file).read_text()
        except OSError as e:
            raise Stop(f"✗ cannot read --body-file: {e}", 2)

    repo = resolve_repo()
    branch, subjects = preflight(repo)
    origin_nwo = parse_nwo(git("remote", "get-url", "origin", check=False)) or repo.nwo
    may_merge, why = policy_for(repo.nwo, KIT_DIR, aliases=(origin_nwo,))
    advisory = split_list(os.environ.get("LAND_ADVISORY_CHECKS")
                          or git("config", "--get", "zs-land.advisoryChecks", check=False))

    if args.dry_run:
        say(f"repo      {repo.nwo} (default {repo.default})")
        say(f"branch    {branch}, {len(subjects)} commit(s) ahead")
        say(f"title     {args.title or subjects[0]}")
        say(f"policy    {'merge after green CI' if may_merge and not args.pr else 'open the PR and stop'} ({why})")
        if advisory:
            say(f"advisory  {', '.join(sorted(advisory))}")
        return 0

    # Read the SHA first and push exactly that commit: a commit made while land runs is
    # never pushed or merged by this run.
    sha = git("rev-parse", "HEAD")
    push = subprocess.run(["git", "push", "-q", "-u", "origin", f"{sha}:refs/heads/{branch}"],
                          capture_output=True, text=True, env=_env())
    if push.returncode != 0:
        raise Stop(f"✗ push failed: {push.stderr.strip()}\n  If the remote branch moved, fetch and rebase "
                   f"(or push with --force-with-lease) before running land again.")

    pr, opened_now = find_or_open_pr(repo, branch, subjects, args.title, body)
    opened_at = time.monotonic() if opened_now else None
    url = pr["html_url"]
    if args.pr:
        say(f"✓ PR ready for review: {url}")
        return 0
    if not may_merge:
        say(f"✓ PR open for review: {url}\n  Not merging: {why}.")
        return 0
    if pr.get("draft"):
        raise Stop(f"✗ PR #{pr['number']} is a draft; mark it ready on GitHub (the cloud proxy cannot): {url}")

    verdict = wait_for_ci(repo, pr["number"], sha, url, advisory, opened_at)
    say(f"✓ CI green: {', '.join(verdict.passed)}"
        + (f" (advisory, not gating: {', '.join(verdict.advisory)})" if verdict.advisory else ""))
    live = recheck(repo, pr["number"], sha, url, advisory)
    merge_sha = merge(repo, live, sha, subjects)

    try:
        problems = after_merge(repo, live, branch, sha, merge_sha)
    except Exception as e:  # noqa: BLE001 — the PR is merged; any failure here is exit 3
        problems = [str(e) or type(e).__name__]
    if problems:
        raise Stop(f"✗ PR MERGED ({url}), but: {'; '.join(problems)} — finish by hand, do NOT re-run land", 3)
    say(f"✓ landed {url} → {repo.default} ({merge_sha[:7]}); now on {repo.default}. "
        f"Start a new branch for the next change.")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Stop as stop:
        print(stop, file=sys.stderr)
        sys.exit(stop.code)
    except GhError as e:
        print(f"✗ GitHub API error: {e}", file=sys.stderr)
        sys.exit(1)
