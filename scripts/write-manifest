#!/usr/bin/env python3
"""Rewrite MANIFEST (path list, read by kits installed before 2026-10-21) and
MANIFEST.sha256 (hash + path, read by setup.sh) from the files setup.sh ships.
Run after changing any shipped file; tests/test_setup.py fails until you do."""
import hashlib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SHIPPED_DIRS = ("bin", "hooks", "lib", "claude", "policy")


def shipped() -> list[str]:
    files = {"setup.sh"}
    for d in SHIPPED_DIRS:
        files |= {str(p.relative_to(ROOT)) for p in (ROOT / d).iterdir()
                  if p.is_file() and p.name != "Icon\r" and "__pycache__" not in str(p)}
    return sorted(files)


def render() -> tuple[str, str]:
    files = shipped()
    plain = "# Files setup.sh fetches from raw.githubusercontent.com. Generated by scripts/write-manifest.\n"
    plain += "\n".join(files) + "\n"
    hashed = "# sha256  path — generated by scripts/write-manifest; setup.sh refuses files that differ.\n"
    hashed += "\n".join(f"{hashlib.sha256((ROOT / f).read_bytes()).hexdigest()}  {f}" for f in files) + "\n"
    return plain, hashed


if __name__ == "__main__":
    plain, hashed = render()
    (ROOT / "MANIFEST").write_text(plain)
    (ROOT / "MANIFEST.sha256").write_text(hashed)
    print(f"wrote MANIFEST and MANIFEST.sha256 ({len(shipped())} files)")
